        </mxCell>
        <mxCell id="2BShQBDZR6Krd0XarQ3t-14" value="&lt;span style=&quot;text-align: left;&quot;&gt;Represents the rules of the game such as summoning characters, starting the game,...&lt;/span&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" vertex="1" parent="1">
